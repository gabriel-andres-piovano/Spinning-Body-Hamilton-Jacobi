Cell[TextData[{
 "The package ",
 StyleBox["SpinOrbitsHamiltonJacobiNoChop",
  FontSlant->"Italic",
  FontColor->GrayLevel[0]],
 StyleBox[" is identical to ",
  FontColor->GrayLevel[0]],
 StyleBox["SpinOrbitsHamiltonJacobi",
  FontSlant->"Italic",
  FontColor->GrayLevel[0]],
 StyleBox[" except for two things: the former does not include any Chop[... \
,10^-16] functions in the sampling of the Fourier series (hence the name). \
The function Chop[... ,10^-16] set to zero any mode that is smaller than the \
threshold 10^-16. Moreover, ",
  FontColor->GrayLevel[0]],
 StyleBox["SpinOrbitsHamiltonJacobiNoChop",
  FontSlant->"Italic",
  FontColor->GrayLevel[0]],
 StyleBox[" gives the Fourier coefficients of ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Xi]", "r"], TraditionalForm]],ExpressionUUID->
  "de8084fd-4ec6-4a61-ae29-ba072b377c27"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Xi]", "z"], TraditionalForm]],ExpressionUUID->
  "c864b0ec-1a46-4da4-9096-ae33014ccfae"],
 "."
}], "Text",
