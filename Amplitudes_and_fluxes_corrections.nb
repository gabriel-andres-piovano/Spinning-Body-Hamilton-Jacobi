           RowBox[{"(*", 
            RowBox[{
             RowBox[{"Quite", " ", "demanding"}], ",", " ", 
             RowBox[{"it", " ", "can", " ", "be", " ", "adjusted"}]}], "*)"}],
            "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Precision", "[", "swsh1", "]"}], "<", "20"}], ")"}], 
              "||", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Precision", "[", "dswsh1", "]"}], "<", "20"}], ")"}],
               "||", 
              RowBox[{"(", 
               RowBox[{"swsh1", "===", "Indeterminate"}], ")"}], "||", 
              RowBox[{"(", 
               RowBox[{"dswsh1", "===", "Indeterminate"}], ")"}], "||", 
              RowBox[{"(", 
               RowBox[{"ddswsh1", "===", "Indeterminate"}], ")"}]}], ",", 
             "\n", "  ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"swsh1", ",", "dswsh1", ",", "ddswsh1"}], "}"}], " ", "=",
               " ", 
              RowBox[{"angeigenfunction1corrint", "[", 
               RowBox[{
               "s", ",", "l", ",", "m", ",", "\[Gamma]0", ",", "\[Gamma]1", ",",
                 "\[Theta]"}], "]"}]}]}], "\n", " ", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"swsh1", ",", "dswsh1", ",", "ddswsh1"}], "}"}]}]}], 
         "]"}]}], "\[IndentingNewLine]", "]"}]}], ";", "\n", "\n", " ", 
     RowBox[{"Remove", "[", 
      RowBox[{
      "\[Alpha]n", ",", "\[Beta]n0", ",", "\[Beta]n1", ",", "\[Gamma]n0", ",",
        "\[Gamma]n1"}], "]"}], ";", "\n", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Gamma]1", " ", "\[Lambda]1"}], ",", "swsh1all"}], "}"}]}]}],
    "\n", "]"}]}]], "Input",
