             RowBox[{
              RowBox[{"\[Omega]g", "[", 
               RowBox[{"2", ",", 
                RowBox[{"nvec", "[", 
                 RowBox[{"[", "n", "]"}], "]"}], ",", 
                RowBox[{"kvec", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], ",", 
                RowBox[{"-", "1"}]}], "]"}], "+", 
              RowBox[{"q", " ", "*", "spar", "*", 
               RowBox[{"\[Omega]sFC", "[", 
                RowBox[{"2", ",", 
                 RowBox[{"nvec", "[", 
                  RowBox[{"[", "n", "]"}], "]"}], ",", 
                 RowBox[{"kvec", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", 
                 RowBox[{"-", "1"}]}], "]"}]}]}], " ", ")"}], "u"}], "]"}]}], 
