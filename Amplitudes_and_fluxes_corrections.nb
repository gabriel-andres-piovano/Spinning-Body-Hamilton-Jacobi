Cell["\<\
IMPORTANT NOTE: the code has now been updated to match the sign convention of \
the BHPToolkit. All plots shown in the Section \
\[OpenCurlyDoubleQuote]Waveform snapshots for a spin-precessing secondary\
\[CloseCurlyDoubleQuote] are the same compare to the previous version and the \
plots of the paper apart for a minus sign.\
\>", "Text",
 CellChangeTimes->{{3.981011028793442*^9, 3.981011156582809*^9}, {
  3.9810113092421*^9, 
  3.9810113163941936`*^9}},ExpressionUUID->"2aaad815-40c9-4279-853a-\
7ea6804bc4b8"],

