                  RowBox[{"[", "n", "]"}], "]"}], ",", 
                 RowBox[{"kvec", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", "1"}], "]"}]}]}], " ", 
             ")"}], "u"}], "]"}]}], "+", 
         RowBox[{"q", " ", "*", "sort", "*", 
          RowBox[{"\[Delta]\[ScriptCapitalA]FCortminus", "[", 
           RowBox[{"[", 
            RowBox[{"n", ",", "k"}], "]"}], "]"}], " ", " ", 
