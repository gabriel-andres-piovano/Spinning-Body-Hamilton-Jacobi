Cell[CellGroupData[{

Cell["\<\
Corrections to eigenvalues and eigenfunctions through numerical derivative\
\>", "Subsubsection",ExpressionUUID->"0d02430b-478f-424b-ab0b-2a6e8f13d308"],

Cell[BoxData[
 RowBox[{
  RowBox[{"angeigenvalue1corrint", "[", 
   RowBox[{"s_", ",", "l_", ",", "m_", ",", "\[Gamma]0_", ",", "\[Gamma]1_"}],
    "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"qratio", ",", "\[Lambda]p", ",", "\[Lambda]m"}], "}"}], ",", 
    "\n", "  ", 
    RowBox[{
     RowBox[{"qratio", " ", "=", " ", 
      RowBox[{"1", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}]}]}], ";", "\n", "  ", 
     RowBox[{"\[Lambda]p", " ", "=", " ", 
      RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
       RowBox[{"s", ",", "l", ",", "m", ",", 
        RowBox[{"\[Gamma]0", "+", 
         RowBox[{"qratio", " ", "\[Gamma]1"}]}]}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"\[Lambda]m", " ", "=", " ", 
      RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
       RowBox[{"s", ",", "l", ",", "m", ",", 
        RowBox[{"\[Gamma]0", "-", 
         RowBox[{"qratio", " ", "\[Gamma]1"}]}]}], "]"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Lambda]p", "-", "\[Lambda]m"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", "qratio"}], ")"}]}]}]}], "\n", "]"}]}]], "Input",
 CellChangeTimes->{{3.8685956559582253`*^9, 3.868595657656773*^9}},
 CellLabel->
  "In[141]:=",ExpressionUUID->"f5b9a0f5-27e8-4399-9fce-34667adbb8d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"angeigenfunction1corrint", "[", 
   RowBox[{
   "s_", ",", "l_", ",", "m_", ",", "\[Gamma]0_", ",", "\[Gamma]1_", ",", 
    "\[Theta]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "qratio", ",", "\[Lambda]p", ",", "\[Lambda]m", ",", "swshcoeffp", ",", 
      "swshcoeffm", ",", "swshSp", ",", "swshSm", ",", "swshp", ",", "swshm", 
      ",", "dswshp", ",", "dswshm", ",", "ddswshp", ",", "ddswshm", ",", 
      "swsh1", ",", "dswsh1", ",", "ddswsh1"}], "}"}], ",", "\n", "   ", 
    RowBox[{
     RowBox[{"qratio", " ", "=", " ", 
      RowBox[{"1", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}]}]}], ";", "\n", "   ", 
     RowBox[{"swshcoeffp", " ", "=", " ", 
      RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
       RowBox[{"s", ",", "l", ",", "m", ",", 
        RowBox[{"\[Gamma]0", "+", 
         RowBox[{"qratio", " ", "\[Gamma]1"}]}]}], "]"}]}], ";", "\n", "   ", 
     
     RowBox[{"swshcoeffm", " ", "=", " ", 
      RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
       RowBox[{"s", ",", "l", ",", "m", ",", 
        RowBox[{"\[Gamma]0", "-", 
         RowBox[{"qratio", " ", "\[Gamma]1"}]}]}], "]"}]}], ";", "\n", "   ", 
     
     RowBox[{"swshSp", " ", "=", " ", 
      RowBox[{
       RowBox[{"swshcoeffp", "[", 
        RowBox[{"#", ",", "0"}], "]"}], "&"}]}], ";", "\n", "   ", 
     RowBox[{"swshSm", " ", "=", " ", 
      RowBox[{
       RowBox[{"swshcoeffm", "[", 
        RowBox[{"#", ",", "0"}], "]"}], "&"}]}], ";", "\n", "\n", "   ", 
     RowBox[{"swshp", " ", "=", " ", 
      RowBox[{
       RowBox[{"swshSp", "[", "\[Theta]", "]"}], "//", "Quiet"}]}], ";", "\n",
      "   ", 
     RowBox[{"dswshp", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"swshSp", "'"}], "[", "\[Theta]", "]"}], "//", "Quiet"}]}], ";",
      "\n", "   ", 
     RowBox[{"ddswshp", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"swshSp", "''"}], "[", "\[Theta]", "]"}], "//", "Quiet"}]}], ";",
      "\n", "   ", 
     RowBox[{"swshm", " ", "=", " ", 
      RowBox[{
       RowBox[{"swshSm", "[", "\[Theta]", "]"}], "//", "Quiet"}]}], ";", "\n",
      "   ", 
     RowBox[{"dswshm", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"swshSm", "'"}], "[", "\[Theta]", "]"}], "//", "Quiet"}]}], ";",
      "\n", "   ", 
     RowBox[{"ddswshm", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"swshSm", "''"}], "[", "\[Theta]", "]"}], "//", "Quiet"}]}], ";",
      "\n", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"swshp", "-", "swshm"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "qratio"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"dswshp", "-", "dswshm"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "qratio"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ddswshp", "-", "ddswshm"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "qratio"}], ")"}]}]}], "}"}]}]}], "\n", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.868595659581193*^9, 3.86859567798349*^9}, {
  3.886054220157152*^9, 3.886054223846162*^9}},
 CellLabel->
  "In[142]:=",ExpressionUUID->"54888ba5-43f3-4841-a5c0-48ac1519dc52"]
}, Closed]]
}, Closed]],

