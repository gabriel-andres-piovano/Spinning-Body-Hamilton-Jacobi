                RowBox[{"nvec", "[", 
                 RowBox[{"[", "n", "]"}], "]"}], ",", 
                RowBox[{"kvec", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], ",", "1"}], "]"}], "+", 
              RowBox[{"q", " ", "*", "spar", "*", 
