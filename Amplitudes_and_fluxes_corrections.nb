1c035aafd31f"],

Cell["\<\
This snippet of code computes the spin-weighted spheroidal harmonics and \
their spin corrections (see ). It is the same code used in the package \
TeukolskySpinFluxesHamiltonJacobi.wl\
\>", "Text",
 CellChangeTimes->{{3.936148806842114*^9, 3.936148818547278*^9}, {
  3.93614885131308*^9, 3.936148965235614*^9}, {3.9362359700644712`*^9, 
  3.936235972572044*^9}},ExpressionUUID->"d4e54b92-1324-49f8-a1d0-\
9b3644acd9b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"angparNew", "[", 
   RowBox[{
   "s_", ",", "l_", ",", "m_", ",", "a_", ",", "\[Omega]0_", ",", 
    "\[Omega]1_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Lambda]0", ",", "\[Lambda]1", ",", "\[Gamma]0", ",", "\[Gamma]1", ",",
       "swshY0", ",", "swsh0all", ",", "swsh1all"}], "}"}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"\[Gamma]0", " ", "=", " ", 
      RowBox[{"a", " ", "\[Omega]0"}]}], ";", "\n", " ", 
     RowBox[{"\[Gamma]1", " ", "=", " ", 
      RowBox[{"a", " ", "\[Omega]1"}]}], ";", "\n", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"a", "==", "0"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"\[Lambda]0", "=", 
         RowBox[{
          RowBox[{"l", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "l"}], ")"}]}], "-", 
          RowBox[{"s", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "s"}], ")"}]}]}]}], ";", "\n", "  ", 
        RowBox[{"swshY0", " ", "=", " ", 
         RowBox[{
          RowBox[{"Evaluate", "[", 
           RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
            RowBox[{"s", ",", "l", ",", "m", ",", "#", ",", "0"}], "]"}], 
           "]"}], "&"}]}], ";", "\n", "  ", 
        RowBox[{"swsh0all", " ", "=", " ", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", "\[Theta]", "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"swshY0", "[", "\[Theta]", "]"}], ",", 
             RowBox[{
              RowBox[{"swshY0", "'"}], "[", "\[Theta]", "]"}], ",", 
             RowBox[{
              RowBox[{"swshY0", "''"}], "[", "\[Theta]", "]"}]}], "}"}]}], 
          "]"}]}], ";", "\n", "  ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Lambda]1", ",", "swsh1all"}], "}"}], " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "0"}], "}"}], "&"}]}], "}"}]}], 
        ";"}], "\n", "  ", ",", "\n", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[Lambda]0", ",", "\[Lambda]1", ",", "swsh0all", ",", "swsh1all"}],
           "}"}], "=", " ", 
         RowBox[{
          RowBox[{"angparKerrNew", "[", 
           RowBox[{
           "s", ",", "l", ",", "m", ",", "\[Gamma]0", ",", "\[Gamma]1"}], 
           "]"}], "//", "Quiet"}]}], ";"}]}], "\n", "  ", "]"}], ";", "\n", 
     " ", 
     RowBox[{"{", 
      RowBox[{
      "\[Lambda]0", ",", "\[Lambda]1", ",", "swsh0all", ",", "swsh1all"}], 
      "}"}]}]}], "\n", "]"}]}]], "Input",
 CellChangeTimes->{{3.893758136107922*^9, 3.8937582070124273`*^9}, {
  3.893758275204369*^9, 3.8937582924841757`*^9}, {3.89375832444421*^9, 
  3.893758457043434*^9}},
 CellLabel->
  "In[138]:=",ExpressionUUID->"f6a0297b-008f-40ce-a054-bb959e274496"],

Cell[BoxData[
 RowBox[{
  RowBox[{"angparKerrNew", "[", 
   RowBox[{"s_", ",", "l_", ",", "m_", ",", "\[Gamma]0_", ",", "\[Gamma]1_"}],
    "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "swshcoeff", ",", "\[Lambda]0", ",", "\[Lambda]1", ",", "swsh0all", ",", 
      "swsh1all", ",", "swshS"}], "}"}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"\[Lambda]0", " ", "=", " ", 
      RowBox[{
       RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
        RowBox[{"s", ",", "l", ",", "m", ",", "\[Gamma]0"}], "]"}], "//", 
       "Quiet"}]}], ";", "\n", " ", 
     RowBox[{"swshcoeff", " ", "=", " ", 
      RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
       RowBox[{"s", ",", "l", ",", "m", ",", "\[Gamma]0"}], "]"}]}], ";", 
     "\n", " ", 
     RowBox[{"swshS", " ", "=", " ", 
      RowBox[{
       RowBox[{"swshcoeff", "[", 
        RowBox[{"#", ",", "0"}], "]"}], "&"}]}], ";", "\n", "  ", 
     RowBox[{"swsh0all", " ", "=", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "\[Theta]", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"swshS", "[", "\[Theta]", "]"}], "//", "Quiet"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"swshS", "'"}], "[", "\[Theta]", "]"}], "//", "Quiet"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"swshS", "''"}], "[", "\[Theta]", "]"}], "//", 
           "Quiet"}]}], "}"}]}], "]"}]}], ";", "\n", "\n", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Lambda]1", ",", "swsh1all"}], "}"}], " ", "=", " ", 
      RowBox[{"angpar1corrNew", "[", 
       RowBox[{
       "s", ",", "l", ",", "m", ",", "\[Gamma]0", ",", "\[Gamma]1", ",", 
        "\[Lambda]0", ",", 
        RowBox[{"swshcoeff", "[", 
         RowBox[{"[", 
          RowBox[{"5", ",", 
           RowBox[{"2", ";;"}]}], "]"}], "]"}]}], "]"}]}], ";", "\n", 
     RowBox[{"{", 
      RowBox[{
      "\[Lambda]0", ",", "\[Lambda]1", ",", "swsh0all", ",", "swsh1all"}], 
      "}"}]}]}], "\n", "]"}]}]], "Input",
 CellChangeTimes->{
  3.886053700265739*^9, {3.886053809868136*^9, 3.8860538102549067`*^9}, {
   3.886053993614757*^9, 3.886053997701681*^9}, {3.886054143345977*^9, 
   3.886054148513699*^9}, {3.8937585129740458`*^9, 3.893758623378524*^9}, {
   3.893758679620452*^9, 3.893758680113649*^9}},
 CellLabel->
  "In[139]:=",ExpressionUUID->"c76eee86-074a-43b2-bd84-2c087eac32cb"],

Cell[CellGroupData[{

Cell["Kernel linear corrections SWSH and their eigenvalues", "Subsubsection",
 CellChangeTimes->{{3.868595540497178*^9, 
  3.868595578499777*^9}},ExpressionUUID->"4a69f5ae-ceca-449e-a1b2-\
99226ccba714"],

Cell[BoxData[
 RowBox[{
  RowBox[{"angpar1corrNew", "[", 
   RowBox[{
   "s_", ",", "l_", ",", "m_", ",", "\[Gamma]0_", ",", "\[Gamma]1_", ",", 
    "\[Lambda]0_", ",", "coeff_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "km", ",", " ", "kp", ",", " ", "ks", ",", "an1", ",", " ", "nmin", ",", 
      "nmax", ",", "\[Alpha]n", ",", "an0Tab", ",", "an1Tab", ",", 
      "an0square", ",", "an1square", ",", "an1an0prod", ",", "\[Beta]n0", ",",
       "\[Beta]n1", ",", "\[Gamma]n0", ",", "\[Gamma]n1", ",", "\[Lambda]1", ",",
       "swsh1all", ",", "normterm0", ",", "norm0", ",", "\[ScriptCapitalA]", ",",
       "\[ScriptCapitalB]", ",", "coeff1order", ",", "sign", ",", "sum0", ",",
       "sum1", ",", "nprec1", ",", "\[Theta]", ",", "precODE"}], "}"}], ",", 
    "\[IndentingNewLine]", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"km", " ", "=", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"m", "-", "s"}], "]"}], "/", "2"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"kp", " ", "=", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"m", "+", "s"}], "]"}], "/", "2"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ks", " ", "=", " ", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"kp", "+", "km"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"precODE", "=", 
       RowBox[{"Floor", "[", 
        RowBox[{
         RowBox[{"Precision", "[", 
          RowBox[{"{", 
           RowBox[{"\[Gamma]0", ",", "\[Gamma]1"}], "}"}], "]"}], "-", "1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"an0Tab", " ", "=", " ", 
       RowBox[{"coeff", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nmin", " ", "=", " ", 
       RowBox[{"coeff", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nmax", " ", "=", " ", 
       RowBox[{"coeff", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", " ", 
      RowBox[{"an0square", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"an0Tab", "[", 
             RowBox[{"[", "j", "]"}], "]"}], 
            RowBox[{"an0Tab", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "2", "-", "nmin", "-", "j"}], "]"}], "]"}]}], 
           ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "1", ",", " ", 
             RowBox[{"i", "-", "nmin", "+", "1"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nmin", ",", "nmax"}], "}"}]}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"normterm0", "[", "i_", "]"}], ":=", " ", 
       RowBox[{
        RowBox[{"2", "^", "i"}], " ", 
        RowBox[{"Pochhammer", "[", 
         RowBox[{
          RowBox[{"2", "+", "ks", "+", "i"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], "kp"}], "-", "1"}]}], "]"}], " ", 
        RowBox[{"Hypergeometric1F1", "[", 
         RowBox[{
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "km"}], "+", "i"}], ",", 
          RowBox[{"2", "+", "ks", "+", "i"}], ",", 
          RowBox[{"4", " ", "\[Gamma]0"}]}], "]"}], 
        RowBox[{"an0square", "[", 
         RowBox[{"[", 
          RowBox[{"i", "+", "1"}], "]"}], "]"}]}]}], ";", 
      RowBox[{"sum0", " ", "=", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"normterm0", "[", "i", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nmin", ",", "nmax"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Normalisation", " ", "such", " ", "that", " ", 
         RowBox[{"\[Integral]", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
            SubsuperscriptBox["S", "lm", "*"]}], 
           RowBox[{"(", 
            RowBox[{"\[Theta]", ",", 
             RowBox[{"\[Phi]", ";", "\[Gamma]"}]}], ")"}], 
           RowBox[{
            SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
            SubscriptBox["S", 
             RowBox[{
              RowBox[{"l", "'"}], 
              RowBox[{"m", "'"}]}]]}], 
           RowBox[{"(", 
            RowBox[{"\[Theta]", ",", 
             RowBox[{"\[Phi]", ";", "\[Gamma]"}]}], ")"}], 
           "d\[CapitalOmega]"}]}]}], " ", "=", " ", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\[Delta]", ",", " ", 
           RowBox[{"ll", "'"}]}], "]"}], 
         RowBox[{"Subscript", "[", 
          RowBox[{"\[Delta]", ",", " ", 
           RowBox[{"mm", "'"}]}], "]"}]}]}], " ", "*)"}], 
      "\[IndentingNewLine]", " ", 
      RowBox[{"norm0", "=", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", "\[Pi]"}], "]"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"1", "+", "ks"}], ")"}]}], 
           RowBox[{"E", "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "2"}], " ", "\[Gamma]0"}], ")"}]}], " ", 
           RowBox[{"Gamma", "[", 
            RowBox[{"1", "+", 
             RowBox[{"2", " ", "kp"}]}], "]"}], " ", "sum0"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "Overall", " ", "sign", " ", "such", " ", "that", " ", "the", " ", 
         "\[Gamma]"}], "\[Rule]", 
        RowBox[{"0", " ", "limit", " ", "is", " ", "continuous"}]}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"sign", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"OddQ", "[", "l", "]"}], "&&", 
            RowBox[{"EvenQ", "[", 
             RowBox[{"m", "+", "s"}], "]"}]}], ")"}], "||", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"OddQ", "[", "l", "]"}], "&&", 
            RowBox[{"OddQ", "[", 
             RowBox[{"m", "+", "s"}], "]"}], "&&", 
            RowBox[{"m", ">=", "s"}]}], ")"}], "||", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"EvenQ", "[", "l", "]"}], "&&", 
            RowBox[{"OddQ", "[", 
             RowBox[{"m", "-", "s"}], "]"}], "&&", 
            RowBox[{"m", "<=", "s"}]}], ")"}]}], ",", " ", 
         RowBox[{"-", "1"}], ",", " ", "1"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"coeff1order", "[", "n_", "]"}], ":=", " ", 
       RowBox[{"2", "\[Pi]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Gamma", "[", 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "km"}], "+", "n"}], "]"}], "/", " ", 
          RowBox[{"Gamma", "[", 
           RowBox[{"3", "+", "ks", "+", "n"}], "]"}]}], ")"}], 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"2", "+", "ks", "+", "n"}], ")"}]}], 
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "\[Gamma]0"}], ")"}]}], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{"1", "+", 
          RowBox[{"2", "kp"}]}], "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"2", "kp"}]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"2", "+", "ks", "+", "n", "+", 
             RowBox[{"2", " ", "s"}]}], ")"}], " ", 
           RowBox[{"Hypergeometric1F1", "[", 
            RowBox[{
             RowBox[{"1", "+", 
              RowBox[{"2", " ", "km"}], "+", "n"}], ",", 
             RowBox[{"3", "+", "ks", "+", "n"}], ",", 
             RowBox[{"4", " ", "\[Gamma]0"}]}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "+", "ks", "+", "n"}], ")"}], 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"2", " ", "kp"}], "-", "m", "+", "s"}], ")"}], 
           RowBox[{"Hypergeometric1F1", "[", 
            RowBox[{
             RowBox[{"1", "+", 
              RowBox[{"2", " ", "km"}], "+", "n"}], ",", 
             RowBox[{"2", "+", "ks", "+", "n"}], ",", 
             RowBox[{"4", " ", "\[Gamma]0"}]}], "]"}]}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "First", " ", "order", " ", "correction", " ", "to", " ", "the", " ", 
         
         RowBox[{"eigenvalues", ":", " ", "\[Lambda]1"}]}], " ", "=", " ", 
        RowBox[{"\[Gamma]1", 
         RowBox[{"(", 
          RowBox[{"Alm\[Gamma]1", " ", "+", " ", 
           RowBox[{"2", 
            RowBox[{"(", 
             RowBox[{"\[Gamma]0", " ", "-", " ", "m"}], ")"}]}]}], ")"}]}]}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"\[Lambda]1", " ", "=", " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "/", "norm0"}], ")"}], "^", "2"}]}], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"coeff1order", "[", "i", "]"}], 
           RowBox[{"an0square", "[", 
            RowBox[{"[", 
             RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", "nmin", ",", " ", "nmax"}], "}"}]}], "]"}]}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
