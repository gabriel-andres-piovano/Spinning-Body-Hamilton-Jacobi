Cell[CellGroupData[{

Cell["Calculation of the orbits", "Section",
 CellChangeTimes->{{3.9309123811423492`*^9, 3.9309123851478863`*^9}, {
  3.9309920097703533`*^9, 3.930992014699868*^9}, {3.931429308568811*^9, 
  3.931429316050293*^9}, {3.9315320341425533`*^9, 
  3.931532041699854*^9}},ExpressionUUID->"94d9396e-06c9-4c74-8aa9-\
e7de6fa76bc0"],

Cell[TextData[{
 "IMPORTANT NOTE: all the functions for the orbits take as input the mean \
anomalies ",
 Cell[BoxData[
  FormBox[
