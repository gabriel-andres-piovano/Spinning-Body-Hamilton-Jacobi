Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"hscaledDH", "[", "u_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"q", " ", "*", "sort", "*", 
          RowBox[{"\[Delta]\[ScriptCapitalA]DHortplus", "[", 
           RowBox[{"[", 
            RowBox[{"n", ",", "k"}], "]"}], "]"}], " ", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Omega]g", "[", 
               RowBox[{"2", ",", 
                RowBox[{"nvec", "[", 
                 RowBox[{"[", "n", "]"}], "]"}], ",", 
                RowBox[{"kvec", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], ",", "1"}], "]"}], "+", 
              RowBox[{"q", " ", "*", "spar", "*", 
               RowBox[{"\[Omega]sDH", "[", 
                RowBox[{"2", ",", 
                 RowBox[{"nvec", "[", 
                  RowBox[{"[", "n", "]"}], "]"}], ",", 
                 RowBox[{"kvec", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", "1"}], "]"}]}]}], " ", 
             ")"}], "u"}], "]"}]}], "+", 
         RowBox[{"q", " ", "*", "sort", "*", 
          RowBox[{"\[Delta]\[ScriptCapitalA]DHortminus", "[", 
           RowBox[{"[", 
            RowBox[{"n", ",", "k"}], "]"}], "]"}], " ", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Omega]g", "[", 
               RowBox[{"2", ",", 
                RowBox[{"nvec", "[", 
                 RowBox[{"[", "n", "]"}], "]"}], ",", 
                RowBox[{"kvec", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], ",", 
